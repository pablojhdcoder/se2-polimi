{
  "name": "bbp-backend",
  "version": "1.0.0",
  "description": "Best Bike Paths Backend - Microservices Architecture",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node migrations/run.js",
    "migrate:schema": "node migrations/run.js",
    "migrate:description": "node migrations/add-paths-description-difficulty.js",
    "migrate:normalize": "node migrations/normalize-foreign-keys.js",
    "migrate:all": "node migrations/run-all.js",
    "seed": "node scripts/seed-demo-data.js"
  },
  "keywords": [
    "bike-paths",
    "microservices",
    "express"
  ],
  "author": "BBP Team",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.17.2",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

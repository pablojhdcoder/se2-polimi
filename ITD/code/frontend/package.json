{
  "name": "bbp-frontend",
  "version": "1.0.0",
  "description": "Best Bike Paths Mobile App - React Native",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx --ignore-pattern node_modules --ignore-pattern coverage",
    "lint:fix": "eslint . --ext .js,.jsx --ignore-pattern node_modules --ignore-pattern coverage --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "react-native",
    "expo",
    "bike-paths",
    "mobile"
  ],
  "author": "BBP Team",
  "license": "ISC",
  "dependencies": {
    "@dicebear/collection": "^9.0.0",
    "@dicebear/core": "^9.0.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@rnmapbox/maps": "^10.2.10",
    "axios": "^1.7.7",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.32",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "^15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@testing-library/react-native": "^12.8.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/setup.js",
      "<rootDir>/__tests__/screens/testUtils.jsx"
    ],
    "moduleNameMapper": {
      "^react-native-gesture-handler$": "<rootDir>/__mocks__/react-native-gesture-handler.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
